{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floria Tune",
  "version": "0.1.0",
  "identifier": "com.floriaapps.tune",
  "build": {
    "beforeDevCommand": "pnpm --filter @floria-tune/web dev",
    "beforeBuildCommand": "pnpm --filter @floria-tune/web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Floria Tune",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
